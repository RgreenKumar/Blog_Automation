# Security hardening for /uploads
# Uploaded files here should NEVER be executed as PHP, even if an
# attacker somehow got a .php file renamed with an allowed extension.

# Apache 2.4+
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Disable PHP execution outright if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes
